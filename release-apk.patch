 =?UTF-8?q?APK=20en=20cada=20tag=20vX.Y.Z?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Compila CoachBoard-Android/CoachBoard con Gradle 8.9 (el repo no incluye gradlew)
- Firma el APK release si existen los secretos del keystore; si no, publica el de depuración
- versionName y versionCode salen del tag y del número de ejecución

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01X6DvHcG4otxF6cUiTgX7Ht
---
 .github/workflows/release-apk.yml             | 111 ++++++++++++++++++
 .../CoachBoard/app/build.gradle.kts           |   6 +-
 2 files changed, 115 insertions(+), 2 deletions(-)
 create mode 100644 .github/workflows/release-apk.yml

diff --git a/.github/workflows/release-apk.yml b/.github/workflows/release-apk.yml
new file mode 100644
index 0000000..3bd2e45
--- /dev/null
+++ b/.github/workflows/release-apk.yml
@@ -0,0 +1,111 @@
+name: Release APK
+
+# Publica una release con el APK cada vez que se sube un tag vX.Y.Z:
+#   git tag v1.0.0 && git push origin v1.0.0
+
+on:
+  push:
+    tags:
+      - "v*"
+
+permissions:
+  contents: write # necesario para crear la release
+
+concurrency:
+  group: release-${{ github.ref }}
+  cancel-in-progress: false
+
+env:
+  PROJECT_DIR: CoachBoard-Android/CoachBoard
+  GRADLE_VERSION: "8.9" # la del gradle-wrapper.properties (el repo no incluye gradlew)
+
+jobs:
+  release:
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v5
+
+      - name: Configurar Java 17
+        uses: actions/setup-java@v5
+        with:
+          distribution: temurin
+          java-version: "17"
+
+      - name: Configurar Gradle
+        uses: gradle/actions/setup-gradle@v4
+        with:
+          gradle-version: ${{ env.GRADLE_VERSION }}
+
+      - name: Calcular versión a partir del tag
+        id: version
+        run: |
+          TAG="${GITHUB_REF_NAME}"
+          echo "name=${TAG#v}" >> "$GITHUB_OUTPUT"
+          # versionCode debe crecer en cada release: usamos el nº de ejecución
+          echo "code=${{ github.run_number }}" >> "$GITHUB_OUTPUT"
+
+      - name: Preparar keystore (si existe)
+        id: signing
+        env:
+          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
+        run: |
+          if [ -n "$KEYSTORE_BASE64" ]; then
+            echo "$KEYSTORE_BASE64" | base64 -d > "$RUNNER_TEMP/release.jks"
+            echo "signed=true" >> "$GITHUB_OUTPUT"
+          else
+            echo "::warning::No hay secreto KEYSTORE_BASE64: se publicará un APK de depuración."
+            echo "signed=false" >> "$GITHUB_OUTPUT"
+          fi
+
+      - name: Compilar APK release firmado
+        if: steps.signing.outputs.signed == 'true'
+        working-directory: ${{ env.PROJECT_DIR }}
+        env:
+          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
+          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
+          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
+        run: |
+          gradle assembleRelease --no-daemon \
+            -PappVersionName="${{ steps.version.outputs.name }}" \
+            -PappVersionCode="${{ steps.version.outputs.code }}" \
+            -Pandroid.injected.signing.store.file="$RUNNER_TEMP/release.jks" \
+            -Pandroid.injected.signing.store.password="$KEYSTORE_PASSWORD" \
+            -Pandroid.injected.signing.key.alias="$KEY_ALIAS" \
+            -Pandroid.injected.signing.key.password="$KEY_PASSWORD"
+
+      - name: Compilar APK de depuración (sin keystore)
+        if: steps.signing.outputs.signed != 'true'
+        working-directory: ${{ env.PROJECT_DIR }}
+        run: |
+          gradle assembleDebug --no-daemon \
+            -PappVersionName="${{ steps.version.outputs.name }}" \
+            -PappVersionCode="${{ steps.version.outputs.code }}"
+
+      - name: Renombrar APK
+        run: |
+          if [ "${{ steps.signing.outputs.signed }}" = "true" ]; then
+            SRC_DIR="$PROJECT_DIR/app/build/outputs/apk/release"
+            SUFFIX=""
+          else
+            SRC_DIR="$PROJECT_DIR/app/build/outputs/apk/debug"
+            SUFFIX="-debug"
+          fi
+          APK=$(find "$SRC_DIR" -name "*.apk" | head -n 1)
+          if [ -z "$APK" ]; then echo "::error::No se encontró el APK en $SRC_DIR" && exit 1; fi
+          mkdir -p dist
+          cp "$APK" "dist/CoachBoard-${GITHUB_REF_NAME}${SUFFIX}.apk"
+          ls -la dist
+
+      - name: Publicar release en GitHub
+        uses: softprops/action-gh-release@v2
+        with:
+          name: CoachBoard ${{ github.ref_name }}
+          tag_name: ${{ github.ref_name }}
+          generate_release_notes: true
+          files: dist/*.apk
+
+      - name: Borrar keystore
+        if: always()
+        run: rm -f "$RUNNER_TEMP/release.jks"
diff --git a/CoachBoard-Android/CoachBoard/app/build.gradle.kts b/CoachBoard-Android/CoachBoard/app/build.gradle.kts
index 9c8c65c..dd8569b 100644
--- a/CoachBoard-Android/CoachBoard/app/build.gradle.kts
+++ b/CoachBoard-Android/CoachBoard/app/build.gradle.kts
@@ -11,8 +11,10 @@ android {
         applicationId = "com.entrenador.pro"
         minSdk = 24
         targetSdk = 35
-        versionCode = 1
-        versionName = "1.0"
+        // En local se usan 1 / "1.0". El workflow de release los sobrescribe
+        // con -PappVersionCode y -PappVersionName a partir del tag (v1.2.3).
+        versionCode = (project.findProperty("appVersionCode") as String?)?.toInt() ?: 1
+        versionName = (project.findProperty("appVersionName") as String?) ?: "1.0"
     }
 
     buildTypes {
